#!/command/with-contenv sh
# chronyd uses the configuration generated by the management server, which
# also starts, stops and restarts this service when the configuration changes.
data="${ENS_DATA_DIR:-/data}/chrony"
conf="$data/chrony.conf"

until [ -f "$conf" ]; do sleep 1; done

mkdir -p /run/chrony "$data/state"
# chronyd drops its privileges: let it traverse the data directory to reach
# its state directory, without granting read access to the other files.
chmod o+x "${ENS_DATA_DIR:-/data}" "$data"
chown _chrony:_chrony /run/chrony "$data/state"
chmod 750 /run/chrony

# By default the container does not control the host clock: chronyd only
# serves time. Set ENS_NTP_CLOCK_CONTROL=true and grant the SYS_TIME
# capability to let it discipline the system clock.
clock_flag="-x"
if [ "${ENS_NTP_CLOCK_CONTROL:-false}" = "true" ]; then
  clock_flag=""
fi

exec chronyd -d -u _chrony -f "$conf" $clock_flag
